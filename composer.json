{
  "name": "newroco/eml-viewer",
  "description": "Preview eml files",
  "type": "project",
  "license": "AGPL",
  "authors": [
    {
      "name": "newroco"
    }
  ],
  "require": {
    "php": ">=8.3 <8.6",
    "zbateson/mail-mime-parser": "3.0.6",
    "mpdf/mpdf": "^8.2",
    "ezyang/htmlpurifier": "^4.19",
    "ext-gd": "*",
    "ext-dom": "*",
    "ext-intl": "*",
    "ext-mbstring": "*"
  },
  "provide": {
    "guzzlehttp/psr7": "2.6.0",
    "guzzlehttp/guzzle": "7.0.0",
    "guzzlehttp/promises": "2.0.0",
    "psr/http-message": "2.0.0",
    "psr/log": "*"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8.2"
  },
  "config": {
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    }
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": true,
      "target-directory": "vendor-bin",
      "forward-command": true
    }
  },
  "scripts": {
    "post-install-cmd": [
        "mkdir -p tmp/mpdf",
        "chmod 755 tmp/mpdf"
    ],
    "post-update-cmd": [
        "mkdir -p tmp/mpdf",
        "chmod 755 tmp/mpdf"
    ]
  }
}